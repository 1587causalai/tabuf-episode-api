{"openapi":"3.1.0","info":{"title":"TabUF Episode API","description":"\n一次返回 n 条 episode，每条自己抽一个总体。\n\n表 `values` 是完整格子。`missing_mask` 与 `query_mask` **可以重合**：\n重合处是缺失填补，query 其余是普通预测。没有单独的 y 标签。\n列类型按 70/10/10/5 直接抽（数值/有序/多值/超多值），每列 5% 独立于其它特征。\n","contact":{"name":"tabuf-episode-api","url":"https://github.com/1587causalai/tabuf-episode-api"},"license":{"name":"MIT"},"version":"v0"},"paths":{"/health":{"get":{"tags":["ops"],"summary":"存活检查","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/v0/episodes":{"post":{"tags":["episodes"],"summary":"抽取 n 条观测 episode","operationId":"create_episodes_v0_episodes_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EpisodeRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EpisodeResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"Episode":{"properties":{"seed":{"type":"integer","title":"Seed"},"table":{"$ref":"#/components/schemas/Table"},"population":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Population"},"response_law":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Response Law"},"S":{"anyOf":[{"items":{"items":{"type":"number"},"type":"array"},"type":"array"},{"type":"null"}],"title":"S"}},"type":"object","required":["seed","table"],"title":"Episode"},"EpisodeRequest":{"properties":{"n_units":{"type":"integer","maximum":512.0,"minimum":8.0,"title":"N Units","default":64,"examples":[16]},"n_features":{"type":"integer","maximum":64.0,"minimum":2.0,"title":"N Features","default":8,"examples":[8]},"unit_dim":{"type":"integer","maximum":32.0,"minimum":1.0,"tit