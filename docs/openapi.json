{
  "openapi": "3.1.0",
  "info": {
    "title": "TabUF Episode API",
    "description": "\n一次返回 n 条表 episode。source 选择生成器，默认 discoscm。\n\n各来源语义不同：只有 discoscm 把行当成带潜变量的 unit。\n其它来源（scm / sklearn_* / openml / recsys）各有自己的行含义。\n共享的只是线上信封：完整 values + missing_mask + query_mask。\n目录见 GET /v0/sources。\n",
    "contact": {
      "name": "tabuf-episode-api",
      "url": "https://github.com/1587causalai/tabuf-episode-api"
    },
    "license": {
      "name": "MIT"
    },
    "version": "v0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "存活检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v0/sources": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "来源画像",
        "operationId": "list_sources_v0_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response List Sources V0 Sources Get"
                }
              }
            }
          }
        }
      }
    },
    "/v0/episodes": {
      "post": {
        "tags": [
          "episodes"
        ],
        "summary": "抽取 n 条观测 episode",
        "operationId": "create_episodes_v0_episodes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EpisodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EpisodeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Episode": {
        "properties": {
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "table": {
            "$ref": "#/components/schemas/Table"
          },
          "population": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population"
          },
          "response_law": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Law"
          },
          "mechanism": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mechanism"
          },
          "S": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "S"
          }
        },
        "type": "object",
        "required": [
          "seed",
          "table"
        ],
        "title": "Episode"
      },
      "EpisodeRequest": {
        "properties": {
          "n_units": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 8.0,
            "title": "N Units",
            "description": "行数旋钮。只有 discoscm 把行解释成 unit；scm/sklearn 里是 n_samples",
            "default": 1000,
            "examples": [
              1000
            ]
          },
          "n_features": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "N Features",
            "description": "null 则从先验抽样（众数约 20，支持 2–1000）",
            "default": null
          },
          "unit_dim": {
            "anyOf": [
              {"type": "integer"},
              {"type": "null"}
            ],
            "maximum": 1024.0,
            "minimum": 2.0,
            "title": "Unit Dim",
            "description": "discoscm-only：个体表征维 k。null 则从先验抽样（众数约 16，支持 2–1024）",
            "default": null
          },
          "query_frac": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Frac",
            "description": "缺省则用来源画像默认"
          },
          "missing_frac": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Missing Frac",
            "description": "缺省则用来源画像默认"
          },
          "query_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Mode",
            "description": "cells | label_column | observed_cells；缺省用来源画像"
          },
          "sigma": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Sigma",
            "default": 0.3
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "default": 0
          },
          "n_episodes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "N Episodes",
            "default": 1
          },
          "type_weights": {
            "$ref": "#/components/schemas/TypeWeights",
            "description": "discoscm-only：列类型抽样权重，不必归一化"
          },
          "independent_frac": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Independent Frac",
            "description": "discoscm-only：每列与其它特征独立的概率",
            "default": 0.05
          },
          "dag_edge_p": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Dag Edge P",
            "description": "discoscm-only：遗留字段，仍写入 response_law；新 DAG 不再按 Bernoulli(p) 连边",
            "default": 0.3
          },
          "max_parents": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 512.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Parents",
            "description": "discoscm-only：None 时典型父节点上限 6 且允许少量 hub 超过；显式整数则为所有节点（含 hub）的硬上限",
            "default": null
          },
          "token_heritability": {
            "type": "number",
            "maximum": 0.95,
            "minimum": 0.05,
            "title": "Token Heritability",
            "description": "discoscm-only：子 token 与父信号的余弦目标 α",
            "default": 0.75
          },
          "beta_min": {
            "type": "number",
            "title": "Beta Min",
            "description": "discoscm-only：相对混合权重 |β| 下界（L1 归一之前）",
            "default": 0.5
          },
          "beta_max": {
            "type": "number",
            "title": "Beta Max",
            "description": "discoscm-only：相对混合权重 |β| 上界（L1 归一之前）",
            "default": 2.0
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "canonical: discoscm | scm | sklearn_make_classification | sklearn_make_regression | sklearn_friedman1 | sklearn_low_rank | sklearn_iris | sklearn_wine | sklearn_breast_cancer | sklearn_diabetes | openml | recsys. aliases: sklearn_synthetic | sklearn_real (+ source_name)",
            "default": "discoscm",
            "examples": [
              "discoscm"
            ]
          },
          "source_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Name",
            "description": "别名用的子名称：make_classification / iris / OpenML id 等。canonical 名已自带，此项忽略。"
          },
          "return_mechanism": {
            "type": "boolean",
            "title": "Return Mechanism",
            "default": false
          },
          "debug": {
            "type": "boolean",
            "title": "Debug",
            "default": false
          }
        },
        "type": "object",
        "title": "EpisodeRequest"
      },
      "EpisodeResponse": {
        "properties": {
          "n_episodes": {
            "type": "integer",
            "title": "N Episodes"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/Episode"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "type": "object",
        "required": [
          "n_episodes",
          "episodes"
        ],
        "title": "EpisodeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "version"
        ],
        "title": "HealthResponse"
      },
      "Table": {
        "properties": {
          "n_units": {
            "type": "integer",
            "title": "N Units"
          },
          "n_rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N Rows"
          },
          "n_features": {
            "type": "integer",
            "title": "N Features"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "values": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "Values"
          },
          "missing_mask": {
            "items": {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Missing Mask"
          },
          "query_mask": {
            "items": {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Query Mask"
          },
          "column_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Column Types",
            "description": "numeric | ordinal | binary | categorical | high_cardinality"
          },
          "n_classes": {
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "N Classes"
          },
          "shapes": {
            "$ref": "#/components/schemas/TableShapes"
          },
          "query_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Mode"
          }
        },
        "type": "object",
        "required": [
          "n_units",
          "n_features",
          "values",
          "missing_mask",
          "query_mask",
          "column_types",
          "n_classes",
          "shapes"
        ],
        "title": "Table"
      },
      "TableShapes": {
        "properties": {
          "values": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Values"
          },
          "missing_mask": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Missing Mask"
          },
          "query_mask": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Query Mask"
          },
          "n_missing": {
            "type": "integer",
            "title": "N Missing"
          },
          "n_query": {
            "type": "integer",
            "title": "N Query"
          },
          "n_query_and_missing": {
            "type": "integer",
            "title": "N Query And Missing"
          }
        },
        "type": "object",
        "required": [
          "values",
          "missing_mask",
          "query_mask",
          "n_missing",
          "n_query",
          "n_query_and_missing"
        ],
        "title": "TableShapes"
      },
      "TypeWeights": {
        "properties": {
          "numeric": {
            "type": "number",
            "minimum": 0.0,
            "title": "Numeric",
            "description": "数值列权重",
            "default": 70
          },
          "ordinal": {
            "type": "number",
            "minimum": 0.0,
            "title": "Ordinal",
            "description": "有序列权重",
            "default": 5
          },
          "binary": {
            "type": "number",
            "minimum": 0.0,
            "title": "Binary",
            "description": "二值类别权重",
            "default": 10
          },
          "categorical": {
            "type": "number",
            "minimum": 0.0,
            "title": "Categorical",
            "description": "多值类别权重",
            "default": 5
          },
          "high_cardinality": {
            "type": "number",
            "minimum": 0.0,
            "title": "High Cardinality",
            "description": "超多值类别权重",
            "default": 5
          }
        },
        "type": "object",
        "title": "TypeWeights"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
